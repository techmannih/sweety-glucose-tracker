# Copy this file to .env. These credentials are for local development only.
DATABASE_URL=postgres://sweety:sweety_dev@127.0.0.1:5432/sweety
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Use true behind HTTPS in production. Never use false on a public deployment.
COOKIE_SECURE=false
# Production can serve client/dist from Express after npm run build.
SERVE_CLIENT=false
# Demo account, created only by the explicit seed command.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=SweetyDemo2026!
# Optional: isolated PostgreSQL server used by tests. A temporary database is
# created and dropped; this role must have CREATEDB. Otherwise tests use embedded PG.
# TEST_DATABASE_URL=postgres://sweety:sweety_dev@127.0.0.1:5432/postgres
# Optional no-Docker local database port; update DATABASE_URL to match.
LOCAL_DB_PORT=5432
